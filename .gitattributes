# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare source and config files
*.py text eol=lf diff=python
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.sh text eol=lf

# Windows specific scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.mp4 binary
*.zip binary
*.tar.gz binary
*.pyc binary
