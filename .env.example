# =================================================================
# 崩坏：星穹铁道 — HoYoLAB 官方战绩角色库同步配置模板 (.env.example)
# 使用说明：
# 1. 复制本文件为 .env: cp .env.example .env
# 2. 填入你的通行证账号或 UID (该文件已被 .gitignore 忽略，绝不会被推送到 GitHub)
# 3. 运行: python sync_from_hoyolab.py
# =================================================================

# 账号与密码 (仅在首次登录或 Session 失效时使用)
HOYOLAB_EMAIL=your_email@example.com
HOYOLAB_PASSWORD=your_password

# 游戏角色 UID 与服务器分区
# prod_official_asia (亚服), prod_official_usa (美服), prod_official_euro (欧服), prod_gf_cn (国服官服)
HOYOLAB_ROLE_ID=your_uid
HOYOLAB_SERVER=prod_official_asia
